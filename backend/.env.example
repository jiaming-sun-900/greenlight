# Local development only. In production the key is set in the Vercel project
# settings and is never checked in, never sent to the browser.
ANTHROPIC_API_KEY=your_key_here

# Optional. Comma-separated origins allowed to call this backend cross-origin.
# Leave unset for the normal setup: the Vite dev proxy and the Vercel deployment
# are both same-origin, so no CORS is needed.
# ALLOWED_ORIGINS=http://localhost:5173

# Optional. Per-IP limits on POST /screen. Defaults are 10 and 60.
# Set one to 0 to disable that window; both must be 0 to turn the limiter off.
# SCREEN_RATE_LIMIT_PER_MINUTE=10
# SCREEN_RATE_LIMIT_PER_HOUR=60

# Optional. Set this only when a proxy in front of this process overwrites
# x-forwarded-for / x-real-ip. Without it the rate limiter keys on the socket
# peer, because a directly exposed process would otherwise believe whatever
# address the caller put in the header. Automatic on Vercel.
# TRUST_PROXY_HEADERS=1
